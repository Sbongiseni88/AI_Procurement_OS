# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
# Throwaway build copy made by tests/e2e/server-only-leak.spec.ts
/.leak-probe/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the placeholder template MUST be committed so onboarding is reproducible.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP verification artifacts
/.playwright-mcp/

# Claude Code: share project skills and CLAUDE.md, keep personal settings local
.claude/settings.local.json
CLAUDE.local.md


# Real client documents (ID numbers, bank details, certified copies) must never
# reach GitHub. Keep them here locally; commit only synthetic or redacted fixtures.
/fixtures/private/
