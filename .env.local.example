# AI Procurement OS — environment template.
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
#
# Find these in the Supabase dashboard under Project Settings -> API Keys.

# --- Public: inlined into the browser bundle at build time. --------------------
# Safe to expose. Protected by Row Level Security, which is why RLS is mandatory
# on every table (see docs/ARCHITECTURE.md §1).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# --- Secret: server-only. NEVER prefix with NEXT_PUBLIC_. ----------------------
# This key BYPASSES Row Level Security entirely. Anything holding it can read and
# write every tenant's data. Used only for migrations, admin tasks and trusted
# server code that has already authorised the caller.
SUPABASE_SECRET_KEY=sb_secret_<...>

# Project reference, used by the Supabase CLI for migrations and type codegen.
SUPABASE_PROJECT_ID=<project-ref>
